APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (also read by docker-compose.yml)
POSTGRES_USER=inquest
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=inquest
POSTGRES_TEST_DB=inquest_test
DATABASE_ECHO=false

# SigNoz (optional; only needed by the SigNoz integration)
# Service account with the Viewer role: Settings -> Service Accounts -> Keys
SIGNOZ_BASE_URL=http://localhost:8080
SIGNOZ_API_KEY=change-me
SIGNOZ_TIMEOUT_SECONDS=15
SIGNOZ_MAX_RESPONSE_BYTES=2000000

# MCP server (optional; without a secret every /mcp request is refused)
# Signs assignment-bound investigator tokens. Generate: openssl rand -base64 48
MCP_TOKEN_SECRET=change-me-to-at-least-32-random-characters
MCP_TOKEN_TTL_SECONDS=900
# Host header allowlist (DNS rebinding protection), JSON list; "host:*" allows any port.
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
