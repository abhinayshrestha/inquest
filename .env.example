APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (also read by docker-compose.yml). POSTGRES_USER/PASSWORD are the
# administrative role: a hosted application process must not receive them (D041).
POSTGRES_USER=inquest
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=inquest
POSTGRES_TEST_DB=inquest_test
DATABASE_ECHO=false
# Least-privilege roles (D040, docs/database.md). POSTGRES_USER above is the bootstrap
# administrative role; it provisions these with `uv run python -m scripts.provision_database`.
# The application connects as INQUEST_DB_USER (data access only), Alembic as
# INQUEST_DB_MIGRATION_USER (owns the schema). Left empty, both fall back to POSTGRES_USER
# (local development only: production refuses to start with a privileged role).
# Generate each password with: openssl rand -base64 32
INQUEST_DB_USER=
INQUEST_DB_PASSWORD=
INQUEST_DB_MIGRATION_USER=
INQUEST_DB_MIGRATION_PASSWORD=

# SigNoz (optional; only needed by the SigNoz integration)
# Service account with the Viewer role: Settings -> Service Accounts -> Keys
SIGNOZ_BASE_URL=http://localhost:8080
SIGNOZ_API_KEY=change-me
SIGNOZ_TIMEOUT_SECONDS=15
SIGNOZ_MAX_RESPONSE_BYTES=2000000

# MCP server (optional; without a secret every MCP request is refused)
# Signs assignment-bound investigator tokens. Generate: openssl rand -base64 48
# (APP_ENV=production refuses anything that is not 32+ random bytes in base64.)
MCP_TOKEN_SECRET=change-me-to-at-least-32-random-characters
MCP_TOKEN_TTL_SECONDS=900
# Host header allowlist (DNS rebinding protection), JSON list; "host:*" allows any port.
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
# The backend serves MCP on its own listener, always 127.0.0.1 (D041); investigators reach
# it at http://127.0.0.1:<MCP_PORT>/. The API listener has no /mcp route. (MCP_URL is gone.)
MCP_PORT=8001

# Hosted listener (`uv run poe start` = python -m src.serve; docs/deployment.md). Development
# uses `uv run poe dev`. Behind the TLS proxy, INQUEST_TRUSTED_PROXIES names exactly the
# proxy's address(es), JSON list; forwarded client addresses are honoured only from them.
INQUEST_LISTEN_HOST=127.0.0.1
INQUEST_LISTEN_PORT=8000
INQUEST_TRUSTED_PROXIES=[]
INQUEST_GRACEFUL_SHUTDOWN_SECONDS=30

# Nebius Token Factory (optional; only needed by investigators and the model smoke test)
# API key: Token Factory console -> API keys. Never commit the real value.
NEBIUS_API_KEY=change-me
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs exactly as listed by: uv run python -m scripts.test_nebius_models models
NEBIUS_MAIN_MODEL=
NEBIUS_LOCAL_MODEL=
NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_RETRIES=2
NEBIUS_MAX_OUTPUT_TOKENS=4096
# Main (Ultra) writes full reports; reasoning tokens count toward this limit.
NEBIUS_MAIN_MAX_OUTPUT_TOKENS=16384

# Investigation runner (API execution). Off by default: a development backend never
# spends model budget unless enabled explicitly.
INQUEST_RUNNER_ENABLED=false
# On startup: reconcile legacy turns, resume checkpointed running turns and start turns
# that were accepted but never started (model-consuming). Requires the runner enabled.
INQUEST_RUNNER_RECOVER_ON_STARTUP=false
# Capacity (D036): running turns server-wide and per organization; accepted turns that
# may wait for a slot. Starts and follow-ups beyond running + queued answer 429.
INQUEST_RUNNER_MAX_RUNNING=4
INQUEST_RUNNER_MAX_RUNNING_PER_ORGANIZATION=2
INQUEST_RUNNER_MAX_QUEUED=16
INQUEST_RUNNER_MAX_QUEUED_PER_ORGANIZATION=4

# Abuse limits (D039). Empty objects keep the defaults listed in src/services/limits.py;
# override only what you need. Rates are "<count>/<seconds>" per subject, e.g.
#   INQUEST_RATE_LIMITS={"login.ip": "5/60", "credential_validation.user": "5/3600"}
#   INQUEST_QUOTAS={"environments_per_organization": 50}
# Unknown names or malformed values refuse to start. requests.ip and the stream and
# validation bounds are per process; everything else is shared through PostgreSQL.
INQUEST_RATE_LIMITS={}
INQUEST_QUOTAS={}
# Request bodies beyond this are refused (413) before parsing; JSON deeper than this, 422.
INQUEST_MAX_REQUEST_BYTES=131072
INQUEST_MAX_JSON_DEPTH=32

# Sign-in (OIDC, optional). Leave INQUEST_AUTH_ISSUER empty to keep sign-in and
# organizations disabled; there is no fallback identity. Register a confidential web
# client at the provider with redirect URI {INQUEST_AUTH_PUBLIC_URL}/api/auth/callback.
# Never commit the real client secret.
# Local try-out without a provider account: `docker compose --profile demo up -d oidc`,
# then ISSUER=http://localhost:8090/default, any CLIENT_ID, any CLIENT_SECRET of your own
# and INQUEST_AUTH_COOKIE_SECURE=false (its login form accepts any name; local only).
INQUEST_AUTH_ISSUER=
INQUEST_AUTH_CLIENT_ID=
INQUEST_AUTH_CLIENT_SECRET=
INQUEST_AUTH_SCOPES=openid email profile
# Origin users open in the browser (the React app). https is required except on localhost.
INQUEST_AUTH_PUBLIC_URL=http://localhost:5173
INQUEST_AUTH_SESSION_HOURS=12
INQUEST_AUTH_IDLE_MINUTES=120
# false only for http://localhost development; any other origin refuses to start sign-in.
INQUEST_AUTH_COOKIE_SECURE=true
# Who may use Inquest after signing in (D042): "approval" admits only operator-approved
# users (uv run python -m scripts.admit_user) and teammates signing in from an invitation
# link; "open" admits every provider-verified sign-in. Empty means open, allowed only for
# local development and tests: APP_ENV=production requires approval and refuses to start
# sign-in otherwise.
INQUEST_AUTH_ADMISSION=

# Per-environment credential storage (Phase 7C). Without a valid key ring, credentials
# cannot be saved and stored ones read as unavailable; nothing falls back to the
# process-wide NEBIUS_*/SIGNOZ_* values above. Generate each key with:
#   uv run python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Keys: JSON object {"key_id": "<base64>"}; keep old keys until
# scripts.rotate_credential_key has re-encrypted everything with the active one.
INQUEST_CREDENTIAL_KEYS={}
INQUEST_CREDENTIAL_ACTIVE_KEY=
# Separate key for connection fingerprints; must differ from every encryption key and
# normally never changes (rotating it requires running the rotation command).
INQUEST_CREDENTIAL_FINGERPRINT_KEY=
# Exact origins (scheme://host[:port]) providers may be reached at. Nebius endpoints must
# be listed (https only). Telemetry: public https endpoints are allowed; private or http
# ones only when listed here, e.g. ["http://localhost:8080"] for a local SigNoz.
INQUEST_NEBIUS_ALLOWED_ORIGINS=["https://api.tokenfactory.nebius.com"]
INQUEST_TELEMETRY_ALLOWED_ORIGINS=[]
# Outside local development (APP_ENV local/test), an allowlisted telemetry origin is usable
# only by the organizations granted it here (D037): {"origin": ["organization-id", ...]}.
INQUEST_TELEMETRY_ORIGIN_ORGANIZATIONS={}
# Operator opt-in for environments granted the process-wide NEBIUS_*/SIGNOZ_* development
# credentials (scripts.adopt_legacy --allow-process-credentials). Off by default; always
# refused with APP_ENV=production. Never used for an environment with credentials of its
# own, and never to fill in a missing one.
INQUEST_ALLOW_PROCESS_CREDENTIALS=false
