# The bundled SigNoz behind Inquest's proxy (deploy/compose.signoz.yaml). Rendered at
# start like inquest.conf.template, substituting only:
#   INQUEST_SERVER_NAME         OTLP endpoints (https://<name>:4318, <name>:4317)
#   INQUEST_SIGNOZ_SERVER_NAME  the SigNoz UI
#   INQUEST_OTLP_TOKEN          bearer token every OTLP request must carry
# Same certificate as the app (/etc/nginx/tls); it must name both hosts.
#
# SigNoz's collector has no authentication of its own, so this proxy is the gate: TLS,
# the token, a body bound and a per-address rate. The SigNoz UI has its own login; the
# first account created there becomes its administrator.

# "Bearer " plus a 64-character token is longer than the default bucket holds.
map_hash_bucket_size 128;

map $http_authorization $inquest_otlp_authorized {
    default 0;
    "Bearer ${INQUEST_OTLP_TOKEN}" 1;
}

map $http_upgrade $signoz_connection_upgrade {
    default upgrade;
    "" "";
}

# Exporters batch, and many processes can share one client address (NAT).
limit_req_zone $binary_remote_addr zone=inquest_otlp:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=inquest_signoz_ui:10m rate=20r/s;

# OTLP/HTTP (traces, metrics, logs at /v1/*).
server {
    listen 4318 ssl;
    http2 on;
    server_name ${INQUEST_SERVER_NAME};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    # Exporter batches exceed the API's 128k (OTLP's default batch is ~4 MiB).
    client_max_body_size 16m;
    client_body_buffer_size 1m;
    limit_req zone=inquest_otlp burst=200 nodelay;
    limit_conn inquest_conn 64;

    location / {
        if ($inquest_otlp_authorized = 0) {
            return 401;
        }
        # The collector never needs the token.
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_pass http://signoz-ingester:4318;
    }
}

# OTLP/gRPC.
server {
    listen 4317 ssl;
    http2 on;
    server_name ${INQUEST_SERVER_NAME};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    client_max_body_size 16m;
    limit_req zone=inquest_otlp burst=200 nodelay;
    limit_conn inquest_conn 64;

    location / {
        # 401 reaches gRPC clients as UNAUTHENTICATED.
        if ($inquest_otlp_authorized = 0) {
            return 401;
        }
        grpc_set_header Authorization "";
        grpc_connect_timeout 5s;
        grpc_read_timeout 30s;
        grpc_pass grpc://signoz-ingester:4317;
    }
}

# The SigNoz UI and API on its own host name. SigNoz's frontend is not Inquest's, so it
# gets framing and sniffing protection but not Inquest's CSP.
server {
    listen 443 ssl;
    http2 on;
    server_name ${INQUEST_SIGNOZ_SERVER_NAME};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    keepalive_timeout 30s;
    client_max_body_size 8m;
    limit_conn inquest_conn 32;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    location / {
        limit_req zone=inquest_signoz_ui burst=80 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $signoz_connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        # Long-running queries and live tail.
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_pass http://signoz:8080;
    }
}
